{
  "expo": {
    "name": "dog-care",
    "slug": "dog-care",
    "scheme": "dogcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите доступ к фотографиям для сохранения медицинских документов питомца.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-status-bar"
    ]
  }
}
